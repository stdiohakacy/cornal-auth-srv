# Copy to .env for local development. Values match docker-compose.yml.
NODE_ENV=development
# login | api | worker
APP_ROLE=api
PORT=3001
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Proxies allowed to set X-Forwarded-For (Express trust proxy syntax).
TRUST_PROXY=loopback

# Runtime traffic goes through PgBouncer (transaction pooling).
DATABASE_URL=postgres://cornal_auth:cornal_auth@localhost:6432/cornal_auth
# Migrations and session-level features connect straight to PostgreSQL.
DATABASE_DIRECT_URL=postgres://cornal_auth:cornal_auth@localhost:5432/cornal_auth
# Optional read replica (unset locally).
# DATABASE_REPLICA_URL=
DB_POOL_MAX=5
OUTBOX_RELAY_ENABLED=true

REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Identity
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
APP_LOGIN_URL=http://localhost:3000/login
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# log (development only, prints links) | smtp. Mailpit from docker-compose: http://localhost:8025
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Cornal <no-reply@cornal.local>
# HASH_MAX_CONCURRENCY=
# libuv threadpool (Argon2 runs there); set it to the pod's vCPU count in the login deployment.
# UV_THREADPOOL_SIZE=
# PASSWORD_PEPPER=
# HIBP k-anonymity check of new passwords (only a 5-char SHA-1 prefix leaves the server).
PASSWORD_BREACH_CHECK=true

# Session tokens. JWT_SIGNING_KEYS is required in production (from a secret manager); locally,
# leave it unset for an ephemeral key, or run `pnpm keys:generate >> .env` for a stable one.
# JWT_SIGNING_KEYS=
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=cornal-platform
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_IDLE_TTL_SECONDS=1209600
REFRESH_ABSOLUTE_TTL_SECONDS=2592000
